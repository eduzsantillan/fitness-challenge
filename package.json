{
  "name": "fitness-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-guide.mjs && node scripts/dev.mjs",
    "build": "node scripts/copy-guide.mjs && vite build && node scripts/finalize-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "local": "tsx backend/local.ts",
    "test:http": "node scripts/test-postgres.mjs --http-only",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build && npm run verify:deploy",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:cleanup": "tsx scripts/db-cleanup.ts",
    "test:integration": "node scripts/test-postgres.mjs",
    "verify:deploy": "node scripts/check-deployment.mjs",
    "neon:setup": "tsx scripts/setup-neon.ts",
    "neon:verify": "tsx scripts/verify-neon.ts"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "lucide-react": "1.65.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
