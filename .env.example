# Server-only variables. Never prefix these with VITE_.
# Use a database dedicated to Ritmo (it may be in the same Neon project).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional LOCAL-ONLY DDL connection. Do not upload to Vercel.
# When set, it must target the same database as DATABASE_URL, using its migration role.
MIGRATION_DATABASE_URL=
# Exact public origin with no trailing slash. For local development:
APP_ORIGIN=http://127.0.0.1:5173
# Generate your own with: openssl rand -base64 48
BETTER_AUTH_SECRET=
PG_POOL_MAX=3
# Optional local API port (Vite proxies /api to 3001).
PORT=3001
